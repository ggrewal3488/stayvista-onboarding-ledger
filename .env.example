# Postgres — set automatically when you link a Postgres storage integration
# (Storage tab -> Create Database -> Postgres) to this Vercel project.
DATABASE_URL=

# Optional — only needed for the "Export to Google Sheet" button to write
# into a real, existing Google Sheet instead of just being unavailable.
# See README.md for how to create these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
