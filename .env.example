# Postgres — set automatically when you link a Postgres storage integration
# (Storage tab -> Create Database -> Postgres) to this Vercel project.
DATABASE_URL=

# Optional — only needed for the automatic Google Sheet sync to write into a
# real, existing Google Sheet instead of just being skipped.
# See README.md for how to create these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Required — Google Sign-In. Create an OAuth 2.0 Client ID (type: Web
# application) in Google Cloud Console and add this app's callback URL
# (https://<your-domain>/api/auth/callback/google) as an authorized redirect
# URI. See README.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required — NextAuth session encryption. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Required in production — the app's own public URL, e.g.
# https://stayvista-onboarding-ledger-arya-4ee1.vercel.app
NEXTAUTH_URL=
